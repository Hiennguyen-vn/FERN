{
  "http_p95": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, application, uri))",
  "http_p99": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, application, uri))",
  "http_error_rate": "sum(rate(http_server_requests_seconds_count{status=~\"5..|4..\"}[5m])) by (application) / sum(rate(http_server_requests_seconds_count[5m])) by (application)",
  "hikari_pending": "max(hikaricp_connections_pending)",
  "hikari_timeout_total": "sum(increase(hikaricp_connections_timeout_total[5m])) by (application)",
  "jvm_heap_used": "max(jvm_memory_used_bytes{area=\"heap\"}) by (application)",
  "jvm_threads_live": "max(jvm_threads_live_threads) by (application)",
  "jvm_gc_pause_p99": "histogram_quantile(0.99, sum(rate(jvm_gc_pause_seconds_bucket[5m])) by (le, application))",
  "outbox_terminal_failures": "sum(increase(fern_outbox_terminal_failures_total[5m])) by (service)",
  "projection_lag": "max(fern_projection_consumer_lag) by (application)",
  "payment_failures": "sum(increase(fern_payment_failures_total[5m])) by (application)",
  "kafka_consumer_lag": "max(kafka_consumergroup_lag) by (consumergroup, topic)"
}
