{
  "name": "outbox_inbox_backlog",
  "behavior": "stateful_pos",
  "workload_model": {
    "outlets": 24,
    "terminals_per_outlet": 4,
    "completed_orders_per_minute_per_terminal": 4.2,
    "requests_per_minute_per_terminal": 21
  },
  "request_mix": {
    "create_or_update_order": 40,
    "add_payment": 30,
    "complete_order": 20,
    "read_order_or_session": 10
  },
  "payment_mix": {
    "cash_ratio": 0.25,
    "card_ratio": 0.75,
    "partial_first_payment_ratio": 0.15,
    "retry_same_key_ratio": 0.03
  },
  "timing": {
    "business_date": "2026-03-28",
    "ramp_up": "10m",
    "steady_duration": "15m",
    "recovery_duration": "20m",
    "ramp_down": "5m"
  },
  "chaos_action": {
    "name": "pause_projection_consumer",
    "delay_from_start": "10m",
    "resume_after": "15m"
  },
  "pass_fail": {
    "write_success_rate_gte": 0.99,
    "backlog_drained_within": "20m",
    "terminal_outbox_failures_eq": 0
  },
  "metrics": [
    "outbox pending rows and oldest age",
    "inbox dedup hit count",
    "consumer lag and drain rate",
    "duplicate publish and duplicate consume checks"
  ],
  "bottleneck_hypothesis": [
    "outbox claim batch size is too small",
    "reclaim logic causes republish or retry storms",
    "resume burst overloads consumers"
  ],
  "observability_assertions": [
    "fern_outbox_terminal_failures_total remains zero",
    "outbox oldest age decreases monotonically in recovery",
    "inbox dedup blocks replay after reconnect"
  ],
  "k6": {
    "options": {
      "scenarios": {
        "cashiers": {
          "executor": "ramping-vus",
          "startVUs": 20,
          "stages": [
            { "duration": "10m", "target": 96 },
            { "duration": "35m", "target": 96 },
            { "duration": "5m", "target": 0 }
          ],
          "gracefulRampDown": "30s"
        }
      },
      "thresholds": {
        "http_req_failed": ["rate<0.02"]
      }
    }
  }
}
